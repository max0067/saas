<svg width="1200" height="800" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="heroGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FF3366;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#ff6b8f;stop-opacity:1" />
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="1200" height="800" fill="url(#heroGradient)"/>

  <!-- Geometric shapes for design -->
  <circle cx="900" cy="200" r="150" fill="#ffffff" opacity="0.1"/>
  <circle cx="300" cy="600" r="100" fill="#ffffff" opacity="0.08"/>
  <circle cx="1000" cy="650" r="80" fill="#ffffff" opacity="0.12"/>

  <!-- Icon - Dumbbell -->
  <g transform="translate(500, 320)">
    <rect x="0" y="75" width="200" height="50" rx="8" fill="#ffffff" opacity="0.9"/>
    <circle cx="0" cy="100" r="40" fill="#ffffff" opacity="0.9"/>
    <circle cx="200" cy="100" r="40" fill="#ffffff" opacity="0.9"/>
  </g>

  <!-- Text -->
  <text x="600" y="520" font-family="Inter, sans-serif" font-size="48" font-weight="900" fill="#ffffff" text-anchor="middle" opacity="0.9">
    FITGANG
  </text>
  <text x="600" y="560" font-family="Inter, sans-serif" font-size="24" font-weight="600" fill="#ffffff" text-anchor="middle" opacity="0.7">
    Transforme ton corps
  </text>
</svg>
